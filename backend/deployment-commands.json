{
  "prometheus": {
    "helm": [
      "helm repo add prometheus-community https://prometheus-community.github.io/helm-charts",
      "helm install prometheus prometheus-community/prometheus --version 29.45.1 --namespace monitoring --create-namespace --values prometheus-values.yaml"
    ],
    "yaml": [
      "kubectl apply --server-side -f prometheus-manifests.yaml"
    ],
    "bundle": "helm install prometheus ./prometheus-29.45.1.tgz --namespace monitoring --create-namespace --values prometheus-values.yaml"
  },
  "argo-cd": {
    "helm": [
      "helm repo add argo https://argoproj.github.io/argo-helm",
      "helm install argo-cd argo/argo-cd --version 10.17.1 --namespace argocd --create-namespace --values argo-cd-values.yaml"
    ],
    "yaml": [
      "kubectl apply --server-side -f argo-cd-manifests.yaml"
    ],
    "bundle": "helm install argo-cd ./argo-cd-10.17.1.tgz --namespace argocd --create-namespace --values argo-cd-values.yaml"
  }
}
